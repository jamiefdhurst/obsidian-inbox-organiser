{
  "name": "obsidian-inbox-organiser",
  "version": "0.3.0",
  "description": "Capture any new notes into an inbox and periodically prompt to organise these into other folders within the vault.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "jest",
    "coverage": "jest --coverage",
    "test-ci": "jest --ci --reporters=default --reporters=jest-junit --coverage",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "husky",
    "version": "node version-bump.mjs"
  },
  "keywords": [],
  "author": "Jamie Hurst <jamie@jamiehurst.co.uk>",
  "bugs": {
    "url": "https://github.com/jamiefdhurst/obsidian-inbox-organiser/issues"
  },
  "homepage": "https://github.com/jamiefdhurst/obsidian-inbox-organiser#readme",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/moment": "^2.13.0",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.51.0",
    "esbuild": "^0.28.2",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "jest-junit": "^17.0.0",
    "nano-staged": "^1.0.2",
    "obsidian": "^1.13.1",
    "obsidian-daily-notes-interface": "^0.9.5",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "nano-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  }
}
